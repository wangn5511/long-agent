# setup.sh resolves these values for the current Linux user.
MODEL_AGENT_INSTANCE_NAME=REPLACE_INSTANCE
MODEL_AGENT_ROOT=REPLACE_ROOT
MODEL_AGENT_STATE_DIR=REPLACE_STATE
MODEL_AGENT_IMAGE=model-agent-openhands:local
MODEL_AGENT_BASE_IMAGE=model-agent-openhands-base:local
OPENHANDS_PORT=REPLACE_OPENHANDS_PORT
MLOPS_PORT=REPLACE_MLOPS_PORT
HOST_UID=REPLACE_UID
HOST_GID=REPLACE_GID
DOCKER_GID=REPLACE_DOCKER_GID

# Keep this at the private state directory unless its large MLOps
# subdirectories are symlinked to shared storage. setup.sh detects that layout
# for existing installations and reloads the supplementary group when needed.
MLOPS_SHARED_STORAGE_ROOT=REPLACE_STATE/mlops
MLOPS_SHARED_GROUP=
MLOPS_SHARED_GID=REPLACE_GID

# The controller starts immediately. Automatic source watching stays disabled
# until immutable input artifacts have been bootstrapped and their ids supplied.
MLOPS_TRIGGER_MODE=manual
MLOPS_POLL_INTERVAL_SECONDS=86400
# Existing Runs advance every 5 seconds; this is not COS source polling.
MLOPS_RECONCILE_INTERVAL_SECONDS=5
MLOPS_INCOMING=/var/lib/rightarm-mlops/incoming
MLOPS_WATCH_COMMAND_JSON=
MLOPS_LOOP_SPEC=/app/openhands/mlops_loop/specs/right-arm-gesture-loop-v1-loop.yaml
MLOPS_RUN_TEMPLATE=/app/openhands/mlops_loop/specs/right-arm-gesture-loop-v1-run.yaml

# local is enough for controller/API validation. Use hybrid to keep data jobs
# local while routing training and checkpoint evaluation to isolated GPU
# containers after configs/generated/docker-images.json contains real digests.
MLOPS_EXECUTOR=local
MLOPS_TRAIN_GPU_COUNT=1
# Set this when dataset PKLs contain absolute media paths that GPU containers
# must read without changing the path recorded in the dataset.
MLOPS_DOCKER_SOURCE_ROOT=

# Leave blank to use the bundled workspace directly. Set these only when each
# task conversation should clone a separate model repository.
RIGHTARM_REPOSITORY=
RIGHTARM_BRANCH=

# Fill these with ids printed by `python -m openhands.mlops_loop
# bootstrap-artifact ...` before enabling an automatic watcher.
MLOPS_CHAMPION_BASE_MODEL_ARTIFACT=
MLOPS_FROZEN_TEST_SET_ARTIFACT=
MLOPS_RTM_DETECTOR_ARTIFACT=
MLOPS_RTM_PERSON_POSE_ARTIFACT=
MLOPS_RTM_HAND_POSE_ARTIFACT=
MLOPS_CHAMPION_EVALUATION_ARTIFACT=
MLOPS_CODE_ARTIFACT=
MLOPS_CONTAINER_IMAGE_ARTIFACT=
MLOPS_LABEL_MAPPING_ARTIFACT=
MLOPS_TENSOR_CONTRACT_ARTIFACT=
MLOPS_IMAGE_DIGEST=

# The five manual entry points can accept files explicitly. These defaults make
# the short forms in the README work when compatible artifacts already exist on
# this server. setup.sh fills paths it can safely discover; otherwise set them.
MLOPS_DEFAULT_DATASET_PATH=REPLACE_DEFAULT_DATASET
MLOPS_BASE_MODEL_PATH=REPLACE_BASE_MODEL
MLOPS_RTM_DETECTOR_PATH=REPLACE_RTM_DETECTOR
MLOPS_RTM_PERSON_POSE_PATH=REPLACE_RTM_PERSON_POSE
MLOPS_RTM_HAND_POSE_PATH=REPLACE_RTM_HAND_POSE
MLOPS_DEFAULT_DATASET_ARTIFACT=
MLOPS_BASELINE_MMACTION_DATASET_ARTIFACT=

# Tencent COS credentials remain mounted only in the controller. Restrict the
# optional prefix when this clone must only read one bucket/subtree.
TENCENT_COS_CONFIG_PATH=REPLACE_COS_CONFIG
COSCLI_HOST_PATH=REPLACE_COSCLI
RIGHTARM_COS_ALLOWED_PREFIX=
RIGHTARM_COS_DISK_RESERVE_BYTES=21474836480
