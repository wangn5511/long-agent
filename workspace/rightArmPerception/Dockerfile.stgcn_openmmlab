ARG BASE_IMAGE=cuda_12_devel_miniconda:v1.5
FROM ${BASE_IMAGE} AS openmmlab-base

SHELL ["/bin/bash", "-lc"]

ARG CONDA_ENV_NAME=openmmlab
ARG MP_CONDA_ENV_NAME=mp_py310
ARG MP_PYTHON_VERSION=3.10
ARG MMACTION2_PATH=/home/liutianyi/rightArmPerception/training/mmaction2
ARG TORCH_VERSION=2.4.1
ARG TORCHVISION_VERSION=0.19.1
ARG MMENGINE_VERSION=0.10.7
ARG MMPOSE_VERSION=1.3.2
ARG MMCV_VERSION=2.1.0
ARG MMCV_BUILD_MODE=source
ARG MMCV_WHEEL_URL=https://download.openmmlab.com/mmcv/dist/cu121/torch2.4/index.html
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cu121
ARG TORCH_WHEEL_DIR=/tmp/docker_wheels
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ARG MAX_JOBS=8
ARG TORCH_CUDA_ARCH_LIST=8.0

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_DEFAULT_TIMEOUT=180 \
    PIP_RETRIES=20 \
    PIP_PROGRESS_BAR=on \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_PREFER_BINARY=1 \
    FORCE_CUDA=1 \
    MMCV_WITH_OPS=1 \
    CUDA_HOME=/usr/local/cuda \
    MAX_JOBS=${MAX_JOBS} \
    TORCH_CUDA_ARCH_LIST=${TORCH_CUDA_ARCH_LIST} \
    CONDA_ENV_NAME=${CONDA_ENV_NAME} \
    MP_CONDA_ENV_NAME=${MP_CONDA_ENV_NAME} \
    MMACTION2_PATH=${MMACTION2_PATH} \
    CONDA_DEFAULT_ENV=${CONDA_ENV_NAME} \
    PATH=/opt/miniconda3/envs/${CONDA_ENV_NAME}/bin:/opt/miniconda3/condabin:/opt/miniconda3/bin:${PATH}

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    git \
    ninja-build \
    libegl1 \
    libglib2.0-0 \
    libgl1 \
    libgles2 \
    libsm6 \
    libxext6 \
    libxrender1 \
    && rm -rf /var/lib/apt/lists/*

COPY openmmlab.yml /tmp/openmmlab.yml
COPY docker_wheels ${TORCH_WHEEL_DIR}

RUN set -euxo pipefail && \
    awk '\
      /^prefix:/ {next} \
      /^  - pip:/ {skip=1; next} \
      skip && /^      - / {next} \
      skip && !/^      - / {skip=0} \
      {print}\
    ' /tmp/openmmlab.yml > /tmp/openmmlab-conda.yml && \
    sed -i "s/^name: .*/name: ${CONDA_ENV_NAME}/" /tmp/openmmlab-conda.yml && \
    awk '\
      /^  - pip:/ {inpip=1; next} \
      inpip && /^      - / {sub(/^      - /, ""); print; next} \
      inpip && !/^      - / {exit}\
    ' /tmp/openmmlab.yml > /tmp/openmmlab-pip.txt && \
    grep -Ev '^(torch|torchvision|triton|nvidia-.*|mmcv|mmengine|mmpose|openmim)(==|$)' \
      /tmp/openmmlab-pip.txt > /tmp/openmmlab-pip-extra.txt

RUN /opt/miniconda3/bin/conda env create -f /tmp/openmmlab-conda.yml

RUN /opt/miniconda3/bin/conda run -n ${CONDA_ENV_NAME} \
      python -m pip install -U "pip<25" setuptools wheel -v

RUN set -euxo pipefail && \
    torch_whl="$(find ${TORCH_WHEEL_DIR} -maxdepth 1 -type f -name "torch-${TORCH_VERSION}*linux_x86_64.whl" | head -n 1)" && \
    torchvision_whl="$(find ${TORCH_WHEEL_DIR} -maxdepth 1 -type f -name "torchvision-${TORCHVISION_VERSION}*linux_x86_64.whl" | head -n 1)" && \
    if [ -n "${torch_whl}" ] && [ -n "${torchvision_whl}" ]; then \
      /opt/miniconda3/bin/conda run -n ${CONDA_ENV_NAME} \
        python -m pip install -v "${torch_whl}" "${torchvision_whl}"; \
    else \
      /opt/miniconda3/bin/conda run -n ${CONDA_ENV_NAME} \
        python -m pip install -v --index-url ${TORCH_INDEX_URL} \
        torch==${TORCH_VERSION} torchvision==${TORCHVISION_VERSION}; \
    fi

RUN /opt/miniconda3/bin/conda run -n ${CONDA_ENV_NAME} \
      python -m pip install -v --index-url ${PIP_INDEX_URL} \
      openmim==0.3.9 mmengine==${MMENGINE_VERSION} mmpose==${MMPOSE_VERSION}

RUN set -euxo pipefail && \
    if [ "${MMCV_BUILD_MODE}" = "prebuilt" ]; then \
      /opt/miniconda3/bin/conda run -n ${CONDA_ENV_NAME} \
        mim install -v mmcv==${MMCV_VERSION} -f ${MMCV_WHEEL_URL}; \
    else \
      /opt/miniconda3/bin/conda run -n ${CONDA_ENV_NAME} \
        mim install -v mmcv==${MMCV_VERSION} -i ${PIP_INDEX_URL}; \
    fi

RUN /opt/miniconda3/bin/conda run -n ${CONDA_ENV_NAME} \
      python -m pip install -v --index-url ${PIP_INDEX_URL} \
      -r /tmp/openmmlab-pip-extra.txt

RUN /opt/miniconda3/bin/conda create -y -n ${MP_CONDA_ENV_NAME} python=${MP_PYTHON_VERSION}

RUN /opt/miniconda3/bin/conda run -n ${MP_CONDA_ENV_NAME} \
      python -m pip install -U "pip<25" setuptools wheel -v

RUN /opt/miniconda3/bin/conda run -n ${MP_CONDA_ENV_NAME} \
      python -m pip install -v --index-url ${PIP_INDEX_URL} \
      numpy opencv-python mediapipe tqdm

RUN rm -rf /tmp/openmmlab*.yml /tmp/openmmlab-pip*.txt

FROM openmmlab-base AS runtime

SHELL ["/bin/bash", "-lc"]

COPY training/mmaction2 ${MMACTION2_PATH}

RUN set -euxo pipefail && \
    /opt/miniconda3/bin/conda run -n ${CONDA_ENV_NAME} \
      python -m pip install -v --no-build-isolation -e ${MMACTION2_PATH}

WORKDIR ${MMACTION2_PATH}

CMD ["/bin/bash"]
